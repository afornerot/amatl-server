{% extends 'base.html.twig' %}

{% block body %}  <div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Posez votre question</h5>
            <form id="question-form">
                <div class="mb-3">
                    <textarea id="question" class="form-control" rows="4" placeholder="Entrez votre question ici..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Valider</button>
            </form>

            <div id="response" class="alert alert-info mt-4 d-none"></div>
        </div>
    </div>

{% endblock %}

{% block localscript %}

<script>
    $('#question-form').on('submit', function(e) {
        e.preventDefault();
        const question = $('#question').val();
        
        $.ajax({
            url: '{{path('app_corpus_search')}}',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ question: question }),
            success: function(data) {
                $('#response').removeClass('d-none').text(data.response);
            },
            error: function(xhr) {
                const errorMsg = xhr.responseJSON?.error || 'Une erreur est survenue.';
                $('#response').removeClass('d-none').removeClass('alert-info').addClass('alert-danger').text(errorMsg);
            }
        });
    });
</script>

{% endblock %}