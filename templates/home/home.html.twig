{% extends 'base.html.twig' %}

{% block localstyle %}
    <style>
        content {
            padding:0px;
        }
        ul {
            padding-left:10px;
            list-style-type:none;
        }
        .file-link {
            font-size:75%;
        }

        #rightbar {
            width:300px;
            overflow-y:auto;
        }

        #toc {
            padding-left:10px;
            flex-grow: 1
        }

        #toc p, #toc a {
            margin-bottom:0px;
            font-size:12px;
        }

    </style>
{% endblock %}

{% import _self as macros %}

{% block body %}
    <div class="d-flex">
        <div class="sidebar d-flex flex-column" style="width: 300px; border-right: 1px solid #ccc; padding: 10px;">
            <div class="flex-grow-1">
                {{ macros.file_tree(files, projectId, '', 0) }}
            </div>

            {% if schemaDir %}
                <div id="mcd-bar" class="my-3">    
                    <a href="{{schemaDir~'/index.html'}}" target="_blank"><i class='fas fa-database fa-2x me-2'></i><span style="font-size: 25px">MCD</span></a>
                </div>
            {% endif %}
            <div id="search-bar" class="my-3">
                <div class="input-group align-items-center">
                    <input type="text" id="search-input" class="form-control border-0 border-bottom" placeholder="Rechercher..." />

                    <button class="btn btn-link text-secondary" type="button" id="search-prev" title="Précédent">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button class="btn btn-link text-secondary" type="button" id="search-next" title="Suivant">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    <button class="btn btn-link text-danger" type="button" id="search-clear" title="Effacer">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
        
            <div style="zoom:60%">projectID = {{ projectUuid }} </div>
        </div>
        <div id="file-viewer" style="flex-grow: 1; padding: 10px; background-color: #fff">
            <iframe id="preview-frame" style="width: 100%; height: 600px; border: none;"></iframe>
        </div>
        <div id="rightbar" class="d-flex flex-column">
            <div id="zoom-controls">
                <div class="input-group justify-content-center" style="margin:auto">
                    <button class="btn btn-link text-secondary" type="button" id="zoom-out" title="Zoom -">
                    <i class="fas fa-minus"></i>
                    </button>
                    <button class="btn btn-link text-secondary" type="button" id="zoom-in" title="Zoom +">
                    <i class="fas fa-plus"></i>
                    </button>
                    <button class="btn btn-link text-danger" type="button" id="zoom-reset" title="Réinitialiser zoom">
                    <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
            <div id="toc">
            </div>  

            <div id="download" style="text-align:center">
                <a id="linkmd" href="" class="btn btn-outline-primary" style="width:190px">
                <i class="fas fa-file-alt me-1"></i> Télécharger le .MD
                </a>

                <a id="linkpdf" href="" class="btn btn-outline-danger" style="width:190px">
                <i class="fas fa-file-pdf me-1"></i> Télécharger le PDF
                </a>
            </div>      
        </div>

    </div>

    <script>
//-- Ajustement à la taille de la windows ---------------------------------------------------------------------------------------
        function adjustIframeHeight() {
            let iframe = document.getElementById("preview-frame");
            iframe.style.height = window.innerHeight - iframe.offsetTop - 20+ "px";

            let rightbar = document.getElementById("rightbar");
            rightbar.style.height = window.innerHeight - rightbar.offsetTop - 20+ "px";            
        }

//-- Affichage de l'iframe ------------------------------------------------------------------------------------------------------
        document.addEventListener("DOMContentLoaded", function () {
            adjustIframeHeight();
            window.addEventListener("resize", adjustIframeHeight);

            document.querySelectorAll(".folder-toggle").forEach(function(toggle) {
                toggle.addEventListener("click", function() {
                    let sublist = this.nextElementSibling;
                    if (sublist.style.display === "none") {
                        sublist.style.display = "block";
                    } else {
                        sublist.style.display = "none";
                    }
                });
            });

            document.querySelectorAll(".file-link").forEach(function(link) {
                link.addEventListener("click", function(event) {
                    event.preventDefault();
                    let filePath = this.getAttribute("data-file-path");
                    let url = "{{ path('view_file', { idProject: projectId, filePath: 'xxx' }) }}";
                    url=url.replace('xxx',filePath);
                    document.getElementById("preview-frame").src = url;

                    // Mettre à jour l'URL dans la barre d'adresse
                    let newUrl = new URL(window.location);
                    newUrl.searchParams.set("doc", filePath);
                    history.pushState({}, "", newUrl);   
                    
                    // Mise à jour des liens de download
                    url = "{{ path('download_file', {type: 'pdf', idProject: projectId, filePath: 'xxx' }) }}";
                    url=url.replace('xxx',filePath);
                    $("#linkpdf").attr("href",url);

                    url = "{{ path('download_file', {type: 'md', idProject: projectId, filePath: 'xxx' }) }}";
                    url=url.replace('xxx',filePath);
                    $("#linkmd").attr("href",url);
                });
            });

            {% if doc %}
                let url = "{{ path('view_file', { idProject: projectId, filePath: doc }) }}";
                document.getElementById("preview-frame").src = url;

                url = "{{ path('download_file', {type: 'pdf', idProject: projectId, filePath: doc }) }}";
                $("#linkpdf").attr("href",url);

                url = "{{ path('download_file', {type: 'md', idProject: projectId, filePath: doc }) }}";
                $("#linkmd").attr("href",url);

                let fileElement = document.querySelector(`[data-file-path="{{doc}}"]`);
                if (fileElement) {
                    // Déplier les parents pour le rendre visible
                    let parent = fileElement.closest("ul");
                    while (parent) {
                        parent.style.display = "block"; // Affiche le UL parent
                        let parentLi = parent.closest("li");
                        parent = parentLi ? parentLi.closest("ul") : null;
                    }
                }                
            {% endif %}
        });

//-- Récupération du TOC --------------------------------------------------------------------------------------------------------
        const iframe = document.getElementById("preview-frame");
        // Attendre que le contenu soit chargé
        iframe.onload = () => {
            try {
                const iframeDocument = iframe.contentDocument || iframe.contentWindow.document;
                const tocElement = iframeDocument.querySelector('.toc');
                const tocContainer = document.getElementById('toc');

                if (tocElement) {
                    // Par exemple, log le HTML de la TOC
                    console.log('TOC trouvée');
                    tocContainer.innerHTML = '<h5>Table des Matières</h5>'+tocElement.innerHTML;
                    // Tu peux aussi copier, manipuler, cloner, etc.
                    // const cloned = tocElement.cloneNode(true);
                    // document.body.appendChild(cloned);
                } else {
                    tocContainer.innerHTML = '';
                    console.log('Pas de .toc trouvée dans l’iframe');
                }
            } catch (e) {
                console.error('Impossible d’accéder au contenu de l’iframe :', e);
            }

            // Si zone de recherche 
            searchInIframe();  

            // Si zoom
            setIframeZoom(zoomLevel);            
        }; 

        document.getElementById('toc').addEventListener('click', function(event) {
            const target = event.target.closest('a');
            if (!target) return;

            const href = target.getAttribute('href');
            if (!href.startsWith('#')) return; // ignore les liens externes

            event.preventDefault();

            const iframe = document.getElementById('preview-frame');
            const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
            const targetEl = iframeDoc.querySelector(href); // ex: #section2

            if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth' });
            }
        });

//-- Zone de Recherche ----------------------------------------------------------------------------------------------------------
        let currentMatchIndex = 0;
        let matches = [];

        function clearHighlights(iframeDoc) {
            const highlights = iframeDoc.querySelectorAll('.iframe-highlight');
            highlights.forEach(el => {
                const parent = el.parentNode;
                parent.replaceChild(document.createTextNode(el.textContent), el);
                parent.normalize(); // fusionne les nœuds texte
            });
            matches = [];
            currentMatchIndex = 0;
        }

        function highlightMatches(iframeDoc, query) {
            if (!query) return;

            const walker = iframeDoc.createTreeWalker(
                iframeDoc.body,
                NodeFilter.SHOW_TEXT,
                null,
                false
            );

            const regex = new RegExp(query, 'gi');
            while (walker.nextNode()) {
                const node = walker.currentNode;
                const match = regex.exec(node.textContent);
                if (match) {
                    const span = iframeDoc.createElement('span');
                    span.className = 'iframe-highlight';
                    span.style.backgroundColor = 'yellow';
                    const matchText = node.splitText(match.index);
                    const after = matchText.splitText(match[0].length);
                    const clone = matchText.cloneNode(true);
                    span.appendChild(clone);
                    matchText.parentNode.replaceChild(span, matchText);
                    matches.push(span);
                }
            }
        }

        function scrollToMatch(index) {
            if (matches.length === 0) return;

            matches.forEach(el => el.style.outline = '');
            const el = matches[index];
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.style.outline = '2px solid red';
        }

        function searchInIframe() {
            const iframe = document.getElementById('preview-frame');
            const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
            const query = document.getElementById('search-input').value.trim();

            clearHighlights(iframeDoc);
            matches = [];
            currentMatchIndex = 0;

            if (query.length >= 3) {
                highlightMatches(iframeDoc, query);
                if (matches.length > 0) {
                    scrollToMatch(0);
                }
            }
        }

        document.getElementById('search-input').addEventListener('input', () => {
            searchInIframe();
        });

        document.getElementById('search-next').addEventListener('click', () => {
            if (matches.length === 0) return;
            currentMatchIndex = (currentMatchIndex + 1) % matches.length;
            scrollToMatch(currentMatchIndex);
        });

        document.getElementById('search-prev').addEventListener('click', () => {
            if (matches.length === 0) return;
            currentMatchIndex = (currentMatchIndex - 1 + matches.length) % matches.length;
            scrollToMatch(currentMatchIndex);
        });

        document.getElementById('search-clear').addEventListener('click', () => {
            const iframe = document.getElementById('preview-frame');
            const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;

            // Vider le champ de recherche
            document.getElementById('search-input').value = '';

            // Nettoyer les surlignages
            clearHighlights(iframeDoc);

            // Réinitialiser état interne
            matches = [];
            currentMatchIndex = 0;
        });

//-- Zoom -----------------------------------------------------------------------------------------------------------------------
        let zoomLevel = parseFloat(localStorage.getItem('iframeZoom')) || 1.0;
        const zoomStep = 0.1;
        const minZoom = 0.5;
        const maxZoom = 3.0;

        function setIframeZoom(level) {
        const iframe = document.getElementById('preview-frame');
        const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
        if (!iframeDoc) return;

        let styleTag = iframeDoc.getElementById('zoom-style');
        if (!styleTag) {
            styleTag = iframeDoc.createElement('style');
            styleTag.id = 'zoom-style';
            iframeDoc.head.appendChild(styleTag);
        }
        styleTag.textContent = `body { zoom: ${level}; }`;

        // Sauvegarde dans localStorage
        localStorage.setItem('iframeZoom', level);
        }

        // Appliquer le zoom initial au chargement
        window.addEventListener('load', () => {
            setIframeZoom(zoomLevel);
        });

        document.getElementById('zoom-in').addEventListener('click', () => {
            zoomLevel = Math.min(maxZoom, zoomLevel + zoomStep);
            setIframeZoom(zoomLevel);
        });

        document.getElementById('zoom-out').addEventListener('click', () => {
            zoomLevel = Math.max(minZoom, zoomLevel - zoomStep);
            setIframeZoom(zoomLevel);
        });

        document.getElementById('zoom-reset').addEventListener('click', () => {
            zoomLevel = 1.0;
            setIframeZoom(zoomLevel);
        });

//-- Download PDF / HTML --------------------------------------------------------------------------------------------------------
        function btnPDF(src) {
            console.log(src);
            console.log("==============================");
            
        }
    </script>
{% endblock %}

{% macro file_tree(files, projectId, basePath, niveau) %}
    {% if files is iterable %}
        <ul {{(niveau>0?'style="display:none;"':'')}}>
            {% for file, subFiles in files %}
                <li>
                    {% if subFiles is iterable %}
                        <span class="folder-toggle" style="cursor: pointer; font-weight: bold;">{{ file }}</span>
                        {{ _self.file_tree(subFiles, projectId, file, niveau+1) }}
                    {% else %}
                        <a href="#" class="file-link" data-file-path="{{ subFiles|trim('/') }}">{{ file|replace({".html":""}) }}</a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}