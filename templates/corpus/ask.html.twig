{% extends 'base.html.twig' %}

{% block body %}  <div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Posez votre question</h5>
            <form id="question-form">
                <div class="mb-3">
                    <textarea id="question" class="form-control" rows="4" placeholder="Entrez votre question ici..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Valider</button>
            </form>

            <div id="response" class="alert alert-info mt-4 d-none"></div>
        </div>
    </div>

{% endblock %}

{% block localscript %}

<script>
    $('#question-form').on('submit', function(e) {
        e.preventDefault();
        const question = $('#question').val();

        $.ajax({
            url: '{{path('app_corpus_ask')}}',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ question: question }),
            success: function(data) {
                awnser=data.response.awnser.response;
                search=data.response.search.results;
                
                $('#response').removeClass('d-none').removeClass('alert-danger').addClass('alert-info').text("");
                let html = '';
                
                html +=`<div class="mb-5" style="font-size:150%"><pre style="white-space: pre-wrap;">`+awnser+`</pre></div>`; 
                
                search.forEach((result, index) => {
                    let source = result.source;
                    let accordionId = 'accordion-' + index;
                    html += `
                        <div class="card mb-3">
                            <div class="card-header bg-primary text-white">
                                <strong>Source : ${source}</strong>
                            </div>
                            <div class="card-body">
                                <div class="accordion" id="${accordionId}">`;

                    result.sections.forEach((section, idx) => {
                        let sectionId = accordionId + '-section-' + idx;
                        html += `
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-${sectionId}">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-${sectionId}">
                                        Section ${idx + 1}
                                    </button>
                                </h2>
                                <div id="collapse-${sectionId}" class="accordion-collapse collapse" data-bs-parent="#${accordionId}">
                                    <div class="accordion-body">
                                        <pre style="white-space: pre-wrap;">${section.content}</pre>
                                    </div>
                                </div>
                            </div>`;
                    });

                    html += `
                                </div>
                            </div>
                        </div>`;
                });
                console.log(html);
                $('#response').html(html);                
            },
            error: function(xhr) {
                const errorMsg = xhr.responseJSON?.error || 'Une erreur est survenue.';
                $('#response').removeClass('d-none').removeClass('alert-info').addClass('alert-danger').text(errorMsg);
            }
        });
    });
</script>

{% endblock %}